{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/donate", "destination": "/" },
    { "source": "/donate/", "destination": "/" },
    { "source": "/approach", "destination": "/" },
    { "source": "/approach/", "destination": "/" },
    { "source": "/programs/:path*", "destination": "/" }
  ]
}
